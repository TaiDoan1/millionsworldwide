# Copy thành .env.local khi chạy máy mình; trên Railway đặt trong Variables.
# Không commit file .env thật lên git (.gitignore đã chặn .env*).

# Tài khoản trang quản trị /mw-office.
# BẮT BUỘC trên production: thiếu 2 biến này là /mw-office khóa hẳn (401).
# Chưa đặt thì ở máy dev /mw-office vẫn mở để làm việc.
ADMIN_USER=
ADMIN_PASS=

# Database chính: Postgres trên Railway.
# Cách đặt: Railway → New → Database → Postgres, rồi ở service web thêm
# biến DATABASE_PRIVATE_URL = ${{Postgres.DATABASE_PRIVATE_URL}}
# (đổi tên Postgres nếu anh đặt tên service khác). Dùng URL nội bộ này
# thì web nối Postgres trong cùng mạng Railway, không cần SSL, không lộ
# ra internet. Nếu chỉ có URL công khai thì đặt DATABASE_URL (web sẽ
# tự bật SSL). Chỉ cần 1 trong 2 — có URL là web dùng Postgres, không
# có thì web tự rơi về SQLite rồi file JSON.
DATABASE_PRIVATE_URL=
DATABASE_URL=

# Thư mục lưu đơn hàng, email đăng ký, cài đặt.
# Trên Railway gắn Volume tại /data rồi đặt DATA_DIR=/data để dữ liệu
# không mất mỗi lần deploy lại. Không đặt thì lưu vào app/data.
DATA_DIR=

# Domain chính, dùng cho sitemap và thẻ chia sẻ mạng xã hội.
NEXT_PUBLIC_SITE_URL=https://millionsworldwide.com
